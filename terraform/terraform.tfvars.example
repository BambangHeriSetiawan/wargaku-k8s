# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.
#
# Set cloud_provider to one of: civo | gcp | aws | do
# Then fill in only the section for that provider.

cloud_provider = "civo"

environment = "prod"
node_count  = 1
domain      = "estathub.id"
alert_email = "setiawan.heri.bambang@gmail.com"

# Leave k8s_version empty to use the provider's latest stable.
k8s_version = ""

# ── Civo (cloud_provider = "civo") ────────────────────────────────────────────
civo_token  = "your-civo-api-token"   # https://dashboard.civo.com/security
civo_region = "SGP1"                   # Singapore — closest to Indonesia
node_size   = "g4s.kube.medium"        # 2 vCPU, 4 GB RAM — ~$10/month

# Restrict K8s API access to your IP only (highly recommended)
admin_cidrs = ["YOUR.PUBLIC.IP.HERE/32"]

# ── GCP / GKE (cloud_provider = "gcp") ────────────────────────────────────────
# gcp_project              = "your-gcp-project-id"
# gcp_region               = "asia-southeast1-a"   # zone → zonal cluster (~cheaper)
# gcp_credentials_file     = ""                    # or path to service-account.json
# gcp_node_machine_type    = "e2-medium"           # 2 vCPU, 4 GB — ~$30/month

# ── AWS / EKS (cloud_provider = "aws") ────────────────────────────────────────
# aws_region               = "ap-southeast-1"      # Singapore
# aws_access_key           = ""                    # or set AWS_ACCESS_KEY_ID env var
# aws_secret_key           = ""                    # or set AWS_SECRET_ACCESS_KEY env var
# aws_node_instance_type   = "t3.medium"           # 2 vCPU, 4 GB — ~$30/month
# Requires AWS CLI installed for kubeconfig exec auth: brew install awscli

# ── DigitalOcean / DOKS (cloud_provider = "do") ───────────────────────────────
# do_token                 = "your-do-api-token"   # https://cloud.digitalocean.com/account/api
# do_region                = "sgp1"                # Singapore
# do_node_size             = "s-2vcpu-4gb"         # 2 vCPU, 4 GB — ~$24/month
