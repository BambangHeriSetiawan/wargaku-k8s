# Terraform state — contains sensitive data
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Real variable values and generated kubeconfig
terraform.tfvars
*.tfvars
!*.tfvars.example
kubeconfig.yaml

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log
crash.log
crash.*.log
