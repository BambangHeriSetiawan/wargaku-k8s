# Copy to secret.yaml, fill base64 values, then: kubectl apply -f secret.yaml
# Encode: echo -n "value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-secrets
  namespace: estathub
type: Opaque
data:
  SMTP_HOST: c210cC5nbWFpbC5jb206NTg3   # smtp.gmail.com:587
  SMTP_USER: <base64-encoded>
  SMTP_PASSWORD: <base64-encoded>
  GRAFANA_ALERT_EMAIL: <base64-encoded>  # alerts@estathub.id
  ALERT_EMAIL: <base64-encoded>          # dev@estathub.id
  ONCALL_EMAIL: <base64-encoded>         # oncall@estathub.id
  PAYMENT_TEAM_EMAIL: <base64-encoded>   # payment@estathub.id
  INFRA_TEAM_EMAIL: <base64-encoded>     # infra@estathub.id
