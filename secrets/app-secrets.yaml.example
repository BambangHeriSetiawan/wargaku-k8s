# Copy this to app-secrets.yaml and fill in real values.
# Encode values: echo -n "value" | base64
# Apply: kubectl apply -f k8s/secrets/app-secrets.yaml -n estathub
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: estathub
type: Opaque
data:
  # Database
  DB_HOST: cG9zdGdyZXM=           # postgres
  DB_PORT: NTQzMg==                # 5432
  DB_NAME: ZXN0YXRodWI=           # estathub
  DB_USER: ZXN0YXRodWI=           # estathub
  DB_PASSWORD: <base64-encoded>
  DB_SSL_MODE: ZGlzYWJsZQ==       # disable (use "require" in prod)

  # Redis
  REDIS_ADDR: cmVkaXM6NjM3OQ==    # redis:6379
  REDIS_PASSWORD: ""
  REDIS_DB: MA==                   # 0

  # Firebase
  FIREBASE_PROJECT_ID: <base64-encoded>
  # Firebase credentials JSON is mounted as a volume (see api deployment)

  # Midtrans
  MIDTRANS_SERVER_KEY: <base64-encoded>
  MIDTRANS_CLIENT_KEY: <base64-encoded>
  MIDTRANS_ENV: cHJvZHVjdGlvbg== # production

  # Storage
  STORAGE_BUCKET: <base64-encoded>

  # SMTP
  SMTP_HOST: c210cC5nbWFpbC5jb20=  # smtp.gmail.com
  SMTP_PORT: NTg3                    # 587
  SMTP_USER: <base64-encoded>
  SMTP_PASSWORD: <base64-encoded>
  SMTP_FROM: <base64-encoded>

  # Postgres internal password (used by StatefulSet)
  POSTGRES_PASSWORD: <base64-encoded>
---
apiVersion: v1
kind: Secret
metadata:
  name: firebase-credentials
  namespace: estathub
type: Opaque
data:
  # base64 of your firebase-service-account.json
  firebase-service-account.json: <base64-encoded-json>
